# Copy to .env and fill in — tutor-os-py reads these via os.environ, no
# dotenv loader is wired in, so `export $(cat .env | xargs)` or your shell/
# process manager needs to actually load this file into the environment.

# --- Model gateway (OpenAI-compatible) ---
# Either an OpenCode Zen key/base URL, or plain OpenAI-style ones — the app
# tries OPENCODE_* first, then falls back to OPENAI_*.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Model id to use at boot (see CURATED_MODELS in src/tutor_os/model.py for
# the built-in shortlist; any model id your gateway serves also works).
TUTOR_MODEL=deepseek-v4-flash

# --- Paths ---
# Repo root, if running the server from somewhere other than py/'s parent.
# TUTOR_OS_ROOT=/path/to/aio-learn

# Server port for the `tutor-os-py` packaged entry point (uvicorn --port
# overrides this when running uvicorn directly instead).
PORT=4115
