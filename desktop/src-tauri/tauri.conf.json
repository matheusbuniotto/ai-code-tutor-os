{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tutor OS",
  "version": "0.1.0",
  "identifier": "com.tutor.os",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../frontend": "seed/frontend",
      "../../backend/.agents": "seed/.agents",
      "../../workspace/_meta_example": "seed/workspace/_meta_example"
    }
  }
}
